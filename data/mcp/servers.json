{
  "servers": {
    "Rent": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "http://127.0.0.1:5050/mcp",
      "headers": {
        "Authorization": "Bearer ${RENT_MCP_TOKEN}"
      },
      "timeout": 5.0,
      "sse_read_timeout": 300.0
    },
    "Pipeworx ExchangeRate": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://gateway.pipeworx.io/exchangerate/mcp",
      "headers": {},
      "timeout": 5.0,
      "sse_read_timeout": 300.0
    },
    "GitMCP": {
      "enabled": true,
      "transport": "streamable_http",
      "url": "https://gitmcp.io/docs",
      "headers": {},
      "timeout": 5.0,
      "sse_read_timeout": 300.0
    }
  }
}
