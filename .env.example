# Docker deployment environment (copy to .env on the server; never commit .env).
# Read by docker-compose.yml. Only fill the providers you use.

AI_AGENT_DEFAULT_MODEL=
LLM_MODEL=
LLM_API_KEY=
AI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ALIYUN_1875083326719091_API_KEY=

# Bearer token for the lease MCP endpoint (issued by Lease-Management-System).
RENT_MCP_TOKEN=
# Lease MCP endpoint, reached over the shared docker network.
# LEASE_MCP_URL=http://web:5000/mcp

# npm registry used when building the frontend image.
# NPM_REGISTRY=https://registry.npmmirror.com
